# Editor
.DS_Store
.vscode/
.idea/

# Server logs
*.log
/tmp/*

# Python artifacts from the PLY exporter
__pycache__/
*.pyc

# SVG + PLY intermediates we keep regenerating
*.swp

# Dated backups of figure assets (kept locally for rollback only)
assets/**/*_backup_*.png
assets/**/*_backup_*.pdf
assets/**/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_*.png
assets/**/*_20[0-9][0-9][0-9][0-9][0-9][0-9]_*.pdf

# Source-render PDFs and pre-patch backups never belong in the public deploy.
# The page references only the .webp/.png exports; the multi-MB fig*.pdf
# sources and *.bak / *.prepatch.bak scratch copies are local-only.
assets/figures/*.pdf
assets/**/*.pdf
assets/**/*.prepatch.bak
assets/**/*.bak

# Browser scratch for tools/check_page.py. It sets TMPDIR here when TMPDIR is unset,
# so Chromium's per-launch profile dirs (~14 per --selftest run) land on this volume
# instead of a small /tmp overlay, where filling the disk is unrecoverable from a shell.
.tmp/

# Development render/audit scratch. Never deploy: .nojekyll makes GitHub Pages
# serve dotdirs verbatim, so 69 tracked screenshots (48 MB) of the PRE-REBUILD
# page -- the version whose hero claimed "39.2% ... +1.3% over TALoS", numbers
# the paper's predicate excludes -- were publicly fetchable at /.audit/*.png
# after those claims had been removed from the page itself.
.audit/

# Anything appended AFTER an asset's real extension is scratch by construction
# (fig4_da_pipeline.png.prePS3bak, *.webp.preOrderNeutral, *.svg.bak2, *.pdf.dybak).
# A served asset's name ends at its extension, so this can never match one.
assets/**/*.png.*
assets/**/*.webp.*
assets/**/*.jpg.*
assets/**/*.svg.*
assets/**/*.ply.*
assets/**/*.pdf.*
